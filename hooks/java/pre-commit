#!/usr/bin/env bash
# ==============================================================================
# pre-commit (Java) - Orquestrador com DAG e Execução Assíncrona
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
export _CURRENT_HOOK_ACTION="pre-commit"

source "$TOOLKIT_ROOT/lib/common/env.sh"
source "$TOOLKIT_ROOT/lib/common/logging.sh"
source "$TOOLKIT_ROOT/lib/common/cache.sh"
source "$TOOLKIT_ROOT/lib/common/bootstrap.sh"
source "$TOOLKIT_ROOT/lib/common/updater.sh"
source "$TOOLKIT_ROOT/lib/common/summary.sh"
source "$TOOLKIT_ROOT/lib/common/engine.sh"
source "$TOOLKIT_ROOT/lib/common/tool-update.sh"
source "$TOOLKIT_ROOT/lib/common/commands.sh"

source "$TOOLKIT_ROOT/lib/common/gitleaks.sh"
source "$TOOLKIT_ROOT/lib/java/java-format.sh"
source "$TOOLKIT_ROOT/lib/java/checkstyle.sh"
source "$TOOLKIT_ROOT/lib/common/ast-grep.sh"

[[ ! -f "pom.xml" ]] && exit 0

REPO_NAME="$(basename "$(pwd)")"
LOCAL_BIN="$HOME/.local/bin"
export PATH="$LOCAL_BIN:$PATH"

toolkit_auto_update
env_load
log_init "$REPO_NAME" "pre-commit"
cache_init "$REPO_NAME"

engine_reset
engine_register "gitleaks" "Checando segredos no código (Gitleaks)" step_gitleaks_commit "FEATURE_GITLEAKS"
engine_register "format" "Formatando arquivos Java alterados (GJF)" step_java_format "FEATURE_JAVA_FORMAT"
engine_register "checkstyle" "Verificando regras de estilo (Checkstyle)" step_checkstyle "FEATURE_CHECKSTYLE"
engine_register "ast-grep" "Linter estrutural de AST (ast-grep)" step_ast_grep "FEATURE_AST_GREP"
bootstrap_prepare

engine_run "PRE-COMMIT JAVA"
