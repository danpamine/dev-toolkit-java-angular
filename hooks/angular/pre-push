#!/usr/bin/env bash
# ==============================================================================
# pre-push (Angular) - Orquestrador com DAG e Execução Assíncrona
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
export _CURRENT_HOOK_ACTION="pre-push"

source "$TOOLKIT_ROOT/lib/common/env.sh"
source "$TOOLKIT_ROOT/lib/common/logging.sh"
source "$TOOLKIT_ROOT/lib/common/cache.sh"
source "$TOOLKIT_ROOT/lib/common/bootstrap.sh"
source "$TOOLKIT_ROOT/lib/common/updater.sh"
source "$TOOLKIT_ROOT/lib/common/summary.sh"
source "$TOOLKIT_ROOT/lib/common/engine.sh"
source "$TOOLKIT_ROOT/lib/common/tool-update.sh"
source "$TOOLKIT_ROOT/lib/common/commands.sh"
source "$TOOLKIT_ROOT/lib/angular/bootstrap.sh"

source "$TOOLKIT_ROOT/lib/angular/version-check.sh"
source "$TOOLKIT_ROOT/lib/common/sca-trivy.sh"
source "$TOOLKIT_ROOT/lib/common/osv-scanner.sh"
source "$TOOLKIT_ROOT/lib/angular/build.sh"
source "$TOOLKIT_ROOT/lib/angular/test.sh"
source "$TOOLKIT_ROOT/lib/common/semgrep.sh"

[[ ! -f "angular.json" ]] && exit 0

REPO_NAME="$(basename "$(pwd)")"
LOCAL_BIN="$HOME/.local/bin"
export PATH="$LOCAL_BIN:$PATH"

toolkit_auto_update
env_load
log_init "$REPO_NAME" "pre-push"
cache_init "$REPO_NAME"

engine_reset
engine_register "version" "Validando incremento de versão no package.json" step_version_check "FEATURE_VERSION_CHECK"
engine_register "sca" "Analisando vulnerabilidades (Trivy SCA)" step_sca_universal "FEATURE_SCA"
engine_register "osv" "Analisando vulnerabilidades (OSV-Scanner)" step_osv_scanner "FEATURE_OSV"
engine_register "semgrep" "Análise SAST semântica (Semgrep)" step_semgrep_sast "FEATURE_SEMGREP"
engine_register "build" "Compilando projeto (ng build)" step_angular_build "FEATURE_BUILD"
engine_register "test" "Executando testes unitários (package.json)" step_angular_test "FEATURE_TEST" "build"
bootstrap_prepare

engine_run "PRE-PUSH ANGULAR"
summary_print "RESUMO DA VALIDAÇÃO PRE-PUSH" "Pronto para abertura de PR!" "O projeto NÃO atende aos critérios para push."

summary_has_failures && exit 1
exit 0
