#!/usr/bin/env bash
# ==============================================================================
# pre-push - Entrypoint unificado acionado pelo Git
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [[ -f "pom.xml" ]]; then
    exec "$SCRIPT_DIR/java/pre-push"
elif [[ -f "angular.json" ]]; then
    exec "$SCRIPT_DIR/angular/pre-push"
else
    exit 0
fi
