# =============================================================================
# dev-toolkit — Configurações e Toggles Globais (Java)
# =============================================================================
# [AVISO IMPORTANTE DE ATUALIZAÇÃO]
# NÃO EDITE ESTE ARQUIVO DIRETAMENTE PARA CUSTOMIZAÇÕES PESSOAIS OU TEMPORÁRIAS!
# Este arquivo é versionado no repositório central do Dev Toolkit. Qualquer alteração
# local neste arquivo causará bloqueios ou conflitos no auto-update via Git.
#
# Para alterar ou sobrescrever variáveis/toggles sem quebrar atualizações:
# 1. Via CLI do toolkit (recomendado):
#      dev env-set <NOME_DA_VARIAVEL> <VALOR>
#    (Salva no arquivo .env na raiz do toolkit, que é ignorado pelo Git)
# 2. No terminal para uma única execução:
#      FEATURE_CHECKSTYLE=0 git commit -m "..."
# 3. NUNCA crie arquivos de configuração dentro dos repositórios dos projetos.
# =============================================================================

# Runtime JVM & Spring Boot
SPRING_PROFILES_ACTIVE="local"
PROFILE="local"
JAVA_OPTS="--enable-native-access=ALL-UNNAMED"

# Feature Toggles: Pre-Commit (1 = Ativo, 0 = Inativo)
FEATURE_GITLEAKS=1
FEATURE_JAVA_FORMAT=1
FEATURE_CHECKSTYLE=1
FEATURE_AST_GREP=1

# Feature Toggles: Pre-Push (1 = Ativo, 0 = Inativo)
FEATURE_VERSION_CHECK=1
FEATURE_SCA=1          # Trivy + Syft
FEATURE_OSV=1          # OSV-Scanner
FEATURE_PMD=1
FEATURE_OPENAPI=1
FEATURE_SPOTBUGS=1
FEATURE_MAVEN_VERIFY=1
FEATURE_SEMGREP=1
FEATURE_SEMGREP_REQUIRED=1

# Feature Toggles: Git Pull (1 = Ativo, 0 = Inativo)
FEATURE_GITLEAKS_PULL=1
